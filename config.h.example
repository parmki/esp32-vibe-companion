#pragma once

// ---------------------------------------------------------------------------
// Copy this file to config.h and fill in your own values.
// config.h is gitignored -- never commit real credentials.
// ---------------------------------------------------------------------------

// 2.4 GHz SSID only. ESP32 has no 5 GHz radio.
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// From @BotFather on Telegram.
#define BOT_TOKEN     "123456789:AAExampleTokenReplaceMe"

// Optional: pin a single chat so she only ever answers you. Leave "" to
// answer whoever messages the bot. Find yours via @userinfobot.
#define OWNER_CHAT_ID ""

// How long with no input before she gets lonely (milliseconds).
#define IDLE_TIMEOUT_MS 150000UL

// What she calls you.
#define YOUR_NAME "YourName"

// Her wall clock (POSIX TZ string). Default is Central European with DST --
// change it so she knows what time it is where you actually are.
#define TIMEZONE_TZ "CET-1CEST,M3.5.0,M10.5.0/3"

// Send her mood image back in the Telegram chat, whenever her face changes.
#define SEND_MOOD_PHOTOS 1
