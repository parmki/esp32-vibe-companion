#pragma once

// ---------------------------------------------------------------------------
// Copy this file to config.h and fill in your own values.
// config.h is gitignored -- never commit real credentials.
// ---------------------------------------------------------------------------

// 2.4 GHz SSID only. ESP32 has no 5 GHz radio.
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// From @BotFather on Telegram.
#define BOT_TOKEN     "123456789:AAExampleTokenReplaceMe"

// Optional: pin a single chat so the bot only answers you. Leave "" to
// answer whoever messages the bot. Find yours via @userinfobot.
#define OWNER_CHAT_ID ""

// How long with no input before the bot speaks unprompted (milliseconds).
#define IDLE_TIMEOUT_MS 150000UL

// A display name the bot can address you by (substituted for the %name token).
#define YOUR_NAME "YourName"

// Wall clock (POSIX TZ string). Default is UTC -- change it to your zone.
#define TIMEZONE_TZ "UTC0"

// Send the mood image back in the Telegram chat whenever the face changes.
#define SEND_MOOD_PHOTOS 1
